<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Store\App\Config\Source\RuntimeConfigSource">
        <plugin name="samjuk_performance_store_scopes_cache" type="SamJUK\Performance\Plugin\CacheStoreScopes"/>
    </type>
    <type name="Magento\Framework\View\Config">
        <plugin name="samjuk_performance_view_config_cache" type="SamJUK\Performance\Plugin\CacheViewConfig"/>
    </type>
    <type name="Magento\Elasticsearch\SearchAdapter\Dynamic\DataProvider">
        <plugin name="samjuk_performance_price_aggregation_dedupe" type="SamJUK\Performance\Plugin\DedupePriceAggregation"/>
    </type>
    <type name="Magento\SalesRule\Model\Rule">
        <plugin name="samjuk_performance_skip_no_coupon_lookup" type="SamJUK\Performance\Plugin\SkipNoCouponLookup"/>
    </type>
    <type name="Magento\Framework\App\Http">
        <plugin name="samjuk_performance_preload_capture" type="SamJUK\Performance\Plugin\CapturePreloadClasses"/>
    </type>
    <type name="Magento\Framework\App\Cache\Frontend\Factory">
        <arguments>
            <argument name="decorators" xsi:type="array">
                <item name="samjuk_performance_timing" xsi:type="array">
                    <item name="class" xsi:type="string">SamJUK\Performance\Model\TimedCache</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
