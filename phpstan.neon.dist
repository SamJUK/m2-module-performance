includes:
    - vendor/samjuk/dev-standards/php/magento/phpstan.neon

parameters:
    paths:
        - Build
        - Console
        - Model
        - Observer
        - Plugin
        - registration.php
        - bin
        - preload.php
    # Magento's docblocks under-promise (getStoreFilter() can return null), so don't trust them as certain.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Magento defines BP at boot.
        - '#^Constant BP not found\.$#'
